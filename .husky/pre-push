#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "→ Pre-push: corriendo TODOS los tests (97 tests)..."
npm test
status=$?

if [ $status -ne 0 ]; then
    echo "❌ Tests fallaron. Push bloqueado."
    echo "   Tip: Corre 'npm test' localmente para debuggear"
    exit 1
else
    echo "✅ Todos los tests pasaron. Push permitido."
    exit 0
fi
