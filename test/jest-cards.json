{
  "displayName": "Cards V4 E2E Tests",
  "preset": "ts-jest/presets/default-esm",
  "testEnvironment": "node",
  "roots": ["<rootDir>/cards"],
  "testMatch": ["**/*.e2e-spec.ts"],
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1"
  },
  "transform": {
    "^.+\\.tsx?$": [
      "ts-jest",
      {
        "useESM": true,
        "tsconfig": {
          "module": "ESNext",
          "moduleResolution": "node"
        }
      }
    ]
  },
  "extensionsToTreatAsEsm": [".ts"],
  "testTimeout": 30000,
  "verbose": true,
  "silent": true
}
